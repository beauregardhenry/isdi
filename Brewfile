# System tools for ISDi on macOS: `brew bundle` in this folder.

# adb, for Android phones. iPhones need nothing here: pymobiledevice3 is
# installed with ISDi.
cask "android-platform-tools"

# Pango, which WeasyPrint uses for the consultation report's PDF (the
# "report" extra). Without it, the report can still be printed from the
# browser.
brew "pango"
